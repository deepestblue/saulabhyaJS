{
    "name": "saulabhyajs",
    "version": "0.8.1",
    "type": "module",
    "description": "SaulabhyaJS",
    "main": "src/saulabhya.js",
    "module": "src/saulabhya.js",
    "exports": {
        ".": {
            "import": "./src/saulabhya.js",
            "default": "./src/saulabhya.js"
        }
    },
    "files": [
        "src/",
        "README.md",
        "LICENCE"
    ],
    "directories": {
        "test": "test"
    },
    "scripts": {
        "lint": "npx eslint && markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
        "dev": "npx serve",
        "test": "node scripts/run-tests.mjs",
        "coverage": "node scripts/build.mjs && COVERAGE=1 node scripts/run-tests.mjs && npx nyc report"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/deepestblue/SaulabhyaJS.git"
    },
    "author": "Ambarish Sridharanarayanan",
    "license": "AGPL-3.0-only",
    "bugs": {
        "url": "https://github.com/deepestblue/SaulabhyaJS/issues"
    },
    "homepage": "https://github.com/deepestblue/SaulabhyaJS#readme",
    "sideEffects": false,
    "devDependencies": {
        "esbuild": "^0.28.0",
        "esbuild-plugin-istanbul": "^0.3.0",
        "eslint": "^10.2.1",
        "@eslint/js": "^10.0.1",
        "@stylistic/eslint-plugin": "^5.7.0",
        "eslint-plugin-qunit": "^8.2.6",
        "globals": "^17.0.0",
        "markdownlint-cli2": "^0.24.0",
        "node-qunit-puppeteer": "^2.2.1",
        "nyc": "^18.0.0"
    }
}
